<?xml version="1.0" encoding="UTF-8"?>
<!--
  ribbon.xml — customUI for the Mirare Cite Word add-in.
  ============================================================================
  Notes:
    - xmlns must be the 2009/07 customUI schema (Word 2010+).
    - Every onAction / getLabel / onLoad callback listed here MUST exist as a
      public method on the Connect class — see Connect.cs. Word invokes them
      late-bound via IDispatch, so Connect must expose a class interface
      ([ClassInterface(AutoDispatch)]) or clicks silently do nothing.
    - Office's ribbon engine is *case-sensitive* on callback names.
    - imageMso uses built-in Office icons (no image assets to ship).
-->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui"
          onLoad="OnRibbonLoad">

  <ribbon>
    <tabs>
      <tab id="mrcTab"
           label="Mirare Cite"
           keytip="MR">

        <group id="mrcGroupInsert"
               label="Insert">

          <!-- Primary "Insert Citation" — opens the picker dialog with all
               sources (library + project + remote) in a single list. -->
          <!-- label comes from GetInsertButtonLabel ("Insert Citation" /
               "Edit Citation") — customUI forbids a static label attribute
               alongside getLabel, so label lives only in the callback. -->
          <button id="mrcInsertCitation"
                  getLabel="GetInsertButtonLabel"
                  size="large"
                  imageMso="FieldInsert"
                  onAction="OnInsertCitation"
                  keytip="IC"
                  screentip="Insert a Mirare citation at the cursor"
                  supertip="Opens the Mirare Cite picker. Ctrl/Shift-click to pick several; items already cited in this document are marked with a check. Click with the cursor inside an existing citation to edit it." />

          <!-- Three scoped shortcuts that pre-filter the picker. -->
          <button id="mrcInsertFromLibrary"
                  label="From Library"
                  imageMso="FileOpen"
                  onAction="OnInsertFromLibrary"
                  keytip="IL"
                  screentip="Insert from the primary RefManager library (.refmanager.json)" />

          <button id="mrcInsertFromProject"
                  label="From Project"
                  imageMso="FileOpen"
                  onAction="OnInsertFromProject"
                  keytip="IP"
                  screentip="Insert from a Mirare Cite project file (.mrrcite)" />

          <button id="mrcInsertFromRemote"
                  label="From Remote"
                  imageMso="FindDialog"
                  onAction="OnInsertFromRemote"
                  keytip="IR"
                  screentip="Insert from the remote Mirare API (HTTPS)" />
        </group>

        <group id="mrcGroupStatus" label="Status">
          <button id="mrcRefreshCitedIndicator"
                  label="Refresh Cited Indicator"
                  imageMso="RefreshAll"
                  onAction="OnRefreshCitedIndicator"
                  keytip="RC"
                  screentip="Re-scan the active document and update the cited indicator on the picker list" />

          <!-- A dynamic label that shows how many items are cited right now. -->
          <labelControl id="mrcCitedCount"
                        getLabel="GetCitedCountLabel" />
        </group>

        <group id="mrcGroupBibliography" label="Bibliography">
          <button id="mrcEditBibliography"
                  label="Update Bibliography"
                  imageMso="InsertBibliography"
                  onAction="OnEditBibliography"
                  keytip="UB"
                  screentip="Refresh the bibliography section at the end of the document from all cited items" />
        </group>

        <group id="mrcGroupSettings" label="Settings">
          <button id="mrcSettings"
                  label="Settings"
                  imageMso="ComAddInsDialog"
                  onAction="OnSettings"
                  keytip="ST"
                  screentip="Default citation style, default source, remote endpoint URL" />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
